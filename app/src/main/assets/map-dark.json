{
  "version": 8,
  "name": "Radar Pro Night",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "osm": {
      "type": "vector",
      "url": "https://vector.openstreetmap.org/shortbread_v1/tilejson.json",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#111725"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "osm",
      "source-layer": "land",
      "minzoom": 0,
      "paint": {
        "fill-color": "#151C2C"
      }
    },
    {
      "id": "sites",
      "type": "fill",
      "source": "osm",
      "source-layer": "sites",
      "minzoom": 0,
      "paint": {
        "fill-color": "#1A222C"
      }
    },
    {
      "id": "ocean",
      "type": "fill",
      "source": "osm",
      "source-layer": "ocean",
      "minzoom": 0,
      "paint": {
        "fill-color": "#0B1426"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "osm",
      "source-layer": "water_polygons",
      "minzoom": 0,
      "paint": {
        "fill-color": "#0B1426"
      }
    },
    {
      "id": "water-lines",
      "type": "line",
      "source": "osm",
      "source-layer": "water_lines",
      "minzoom": 0,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#12243C",
        "line-width": 2
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "osm",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": {
        "fill-color": "#1B2333"
      }
    },
    {
      "id": "street-outline",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "minzoom": 0,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#1C2539",
        "line-width": {
          "stops": [
            [
              10,
              1
            ],
            [
              14,
              5
            ],
            [
              17,
              14
            ]
          ]
        }
      }
    },
    {
      "id": "streets",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "minzoom": 0,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#34425B",
        "line-width": {
          "stops": [
            [
              10,
              0.4
            ],
            [
              14,
              2
            ],
            [
              17,
              10
            ]
          ]
        }
      }
    },
    {
      "id": "arterial",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "minzoom": 0,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#695B43",
        "line-width": {
          "stops": [
            [
              8,
              1
            ],
            [
              12,
              2
            ],
            [
              16,
              5
            ]
          ]
        }
      },
      "filter": [
        "in",
        "kind",
        "motorway",
        "trunk",
        "primary"
      ]
    },
    {
      "id": "cities",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place_labels",
      "minzoom": 4,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          [
            "get",
            "name_en"
          ]
        ],
        "text-font": [
          "Open Sans Semibold"
        ],
        "text-size": 15,
        "symbol-placement": "point",
        "text-max-width": 10
      },
      "paint": {
        "text-color": "#A7B3CB",
        "text-halo-color": "#111725",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "street-labels",
      "type": "symbol",
      "source": "osm",
      "source-layer": "street_labels",
      "minzoom": 11,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          [
            "get",
            "name_en"
          ]
        ],
        "text-font": [
          "Open Sans Semibold"
        ],
        "text-size": 11,
        "symbol-placement": "line",
        "text-max-width": 10
      },
      "paint": {
        "text-color": "#A7B3CB",
        "text-halo-color": "#111725",
        "text-halo-width": 1.4
      }
    }
  ]
}
