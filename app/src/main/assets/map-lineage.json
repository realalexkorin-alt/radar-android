{
  "version": 8,
  "name": "SensePro · Lineage 2 Atlas",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "osm": {
      "type": "vector",
      "url": "https://vector.openstreetmap.org/shortbread_v1/tilejson.json",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#D1C8A6"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "osm",
      "source-layer": "land",
      "minzoom": 0,
      "paint": {
        "fill-color": "#B7B491"
      }
    },
    {
      "id": "sites",
      "type": "fill",
      "source": "osm",
      "source-layer": "sites",
      "minzoom": 0,
      "paint": {
        "fill-color": "#ACAE88"
      }
    },
    {
      "id": "ocean",
      "type": "fill",
      "source": "osm",
      "source-layer": "ocean",
      "minzoom": 0,
      "paint": {
        "fill-color": "#788F8C"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "osm",
      "source-layer": "water_polygons",
      "minzoom": 0,
      "paint": {
        "fill-color": "#829B98"
      }
    },
    {
      "id": "water-lines",
      "type": "line",
      "source": "osm",
      "source-layer": "water_lines",
      "minzoom": 0,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#718C8B",
        "line-width": 2
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "osm",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": {
        "fill-color": "#9B947D",
        "fill-outline-color": "#7C7964"
      }
    },
    {
      "id": "street-outline",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "minzoom": 0,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#827C60",
        "line-width": {
          "stops": [
            [
              10,
              1
            ],
            [
              14,
              5
            ],
            [
              17,
              14
            ]
          ]
        }
      }
    },
    {
      "id": "streets",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "minzoom": 0,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#E9DCAC",
        "line-width": {
          "stops": [
            [
              10,
              0.4
            ],
            [
              14,
              2
            ],
            [
              17,
              10
            ]
          ]
        }
      }
    },
    {
      "id": "arterial",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "minzoom": 0,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#BE9C54",
        "line-width": {
          "stops": [
            [
              8,
              1
            ],
            [
              12,
              2
            ],
            [
              16,
              5
            ]
          ]
        }
      },
      "filter": [
        "in",
        "kind",
        "motorway",
        "trunk",
        "primary"
      ]
    },
    {
      "id": "cities",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place_labels",
      "minzoom": 4,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          [
            "get",
            "name_en"
          ]
        ],
        "text-font": [
          "Open Sans Semibold"
        ],
        "text-size": 15,
        "symbol-placement": "point",
        "text-max-width": 10,
        "visibility": "none"
      },
      "paint": {
        "text-color": "#393D30",
        "text-halo-color": "#E6DAB5",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "street-labels",
      "type": "symbol",
      "source": "osm",
      "source-layer": "street_labels",
      "minzoom": 11,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          [
            "get",
            "name_en"
          ]
        ],
        "text-font": [
          "Open Sans Semibold"
        ],
        "text-size": 11,
        "symbol-placement": "line",
        "text-max-width": 10
      },
      "paint": {
        "text-color": "#393D30",
        "text-halo-color": "#E6DAB5",
        "text-halo-width": 1.6
      }
    }
  ]
}
